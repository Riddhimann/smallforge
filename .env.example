# The zero-cost local default. Run `ollama serve` before starting SmallForge.
SMALLFORGE_OLLAMA_URL=http://127.0.0.1:11434
SMALLFORGE_DEFAULT_MODEL=ollama:qwen2.5:3b

# Optional OpenAI-compatible endpoint. Keep secrets outside version control.
SMALLFORGE_OPENAI_BASE_URL=
SMALLFORGE_OPENAI_API_KEY=
SMALLFORGE_OPENAI_MODEL=

SMALLFORGE_DATA_DIR=./data
SMALLFORGE_RESULTS_DIR=./results
SMALLFORGE_MAX_CONCURRENT_EXPERIMENTS=1
